#include <iostream>
using namespace std;

int main() {
    string name, address;
    int age;
    float weight, height;

    cout << "Enter your name: ";
    cin >> name;

    cout << "Enter your age: ";
    cin >> age;

    cout << "Enter your address: ";
    cin.ignore();
    getline(cin, address);

    cout << "Enter your weight (kg): ";
    cin >> weight;

    cout << "Enter your height (cm): ";
    cin >> height;

    cout << "\nMy name is " << name
         << ", I am " << age << " years old, "
         << "I live at " << address
         << ", my weight is " << weight << " kg, "
         << "and my height is " << height << " cm." << endl;

    return 0;
}


